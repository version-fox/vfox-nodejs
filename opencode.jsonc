// OpenCode project permissions, see https://opencode.ai/v2/docs/permissions/
//
// Allows three shell commands in OpenCode sessions in this repository, which a
// contributor's global config may deny. Project rules are appended after the
// global ones and the last matching rule wins, so each "allow" below overrides
// such a "deny" and every other global rule stays. Project configuration
// outranks global configuration, so this applies to everyone who uses OpenCode
// here. Use "ask" instead of "allow" to be prompted for each use.
//
// "gh pr merge *" is left out on purpose: a global deny on it keeps working.
{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr comment *", "effect": "allow" }
  ]
}
