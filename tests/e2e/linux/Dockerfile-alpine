# musl (Alpine) target for the Linux container E2E suite (see docs/musl.md).
# Proves the plugin selects the *-musl tarballs on musl systems
# (https://github.com/version-fox/vfox-nodejs/issues/29): the glibc tarball
# cannot execute here, so install+run passing is the assertion.
#
# NOTE: no heredoc here, same classic-builder constraint as Dockerfile.
FROM alpine:latest

# bash: the Go suite drives every phase through `bash -c` (exec.go);
# coreutils: GNU long options used by the suite (mktemp --directory,
# rm --recursive --force, mkdir --parents);
# libstdc++: Node.js musl builds require it (unofficial-builds docs),
# without it node fails with `Error relocating ... symbol not found`;
# ca-certificates/curl/git/go/zip: same roles as the Ubuntu image.
RUN set -o errexit -o nounset -o xtrace; \
    apk add --no-cache \
        bash \
        ca-certificates \
        coreutils \
        curl \
        git \
        go \
        libstdc++ \
        zip

COPY metadata.lua /e2e/metadata.lua
COPY hooks /e2e/hooks
COPY lib /e2e/lib

# Long-lived container: the Go test drives every phase through exec calls.
CMD ["sleep", "infinity"]
